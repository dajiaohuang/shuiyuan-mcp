[Unit]
Description=Shuiyuan MCP server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/.local/share/shuiyuan-mcp
ExecStart=/usr/bin/env node %h/.local/share/shuiyuan-mcp/dist/shuiyuan-mcp.js --transport http --host 127.0.0.1 --port 3765
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full

[Install]
WantedBy=default.target
